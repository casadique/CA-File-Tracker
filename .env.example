NODE_ENV=production
PORT=3000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CLIENT_CREDENTIALS_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters
SUPABASE_STORAGE_BUCKET=ca-file-tracker-attachments

CORS_ORIGIN=https://your-domain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Generate once with: npm run generate:vapid
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@cafiletracker.net
